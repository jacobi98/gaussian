<script>
(()=>{/* gli elementi dei blocchi rimossi (Image 3D, Emitter 2D, Webcam) non esistono più: chi li cerca riceve un controllo fittizio nascosto */
const g=document.getElementById.bind(document),M={};
document.getElementById=id=>{const e=g(id);if(e||typeof id!=='string')return e;let m=M[id];
if(!m)m=M[id]=mk();return m};
function mk(){const l=document.createElement('label'),i=document.createElement('input');i.type='range';i.min='-1e9';i.max='1e9';i.step='any';l.hidden=true;l.append(i,document.createElement('b'));document.body.appendChild(l);return i}
const q=document.querySelector.bind(document);document.querySelector=s=>q(s)||mk()})();
const OQ=new URLSearchParams(location.search),OUT=OQ.get('output')==='1';
if(OUT)document.body.classList.add('outmode');
let RENDER_CAP=OUT?Math.max(640,Math.min(4096,+OQ.get('cap')||1600)):1600;
let OUTFPS=OUT?Math.max(0,Math.min(240,+OQ.get('fps')||0)):0;
let OUTAUTO=OUT?OQ.get('autoq')!=='0':false;
let OUTLOW=0,PAUSED=false,BLACKOUT=false;
const c=document.getElementById('c'),
gl=c.getContext('webgl2',{preserveDrawingBuffer:!OUT,antialias:false,xrCompatible:true});
if(!gl||!gl.getExtension('EXT_color_buffer_float')){
  document.body.innerHTML='<p style="padding:2rem">Serve un browser con WebGL2 (Chrome, Firefox, Safari recenti).</p>';throw 0}

/* ---------- stato VR (WebXR, PC VR wireless) ---------- */
const XNC=48; /* capsule per mano (mani 3D) */
const CB={on:0,a:0,b:90,g:0,cam:null,vs:[]};

/* ---------- suono granulare: grani di rumore filtrato, più fitti e più acuti quanto più si muovono le particelle ---------- */
const SND={ctx:null,m:null,buf:null,acc:0,sm:0,bufs:[],raw:[],src:null,cd:0};
const $snd=id=>document.getElementById(id);
function sndStatus(t){const e=$snd('sndst');if(e)e.textContent=t}
function sndInit(){
  try{
    if(!SND.ctx){
      const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;
      const c=new AC(),sr=c.sampleRate,b=c.createBuffer(1,sr,sr),d=b.getChannelData(0);
      for(let i=0;i<sr;i++)d[i]=Math.random()*2-1;
      const m=c.createGain();m.gain.value=0;const k=c.createDynamicsCompressor();m.connect(k);k.connect(c.destination);
      SND.ctx=c;SND.buf=b;SND.m=m;
    }
    if(SND.ctx.state==='suspended')SND.ctx.resume().catch(()=>{});
  }catch(e){}
}
['pointerdown','keydown','touchstart'].forEach(ev=>addEventListener(ev,sndInit,{passive:true}));
/* In VR il suono segue le mani/controller solo quando sono dentro la nuvola (come il mouse sul PC): 1 = tocca le particelle, 0 = lontano oltre il raggio d'azione */
function sndTouch(o){
  if(V!=='i3')return 1;
  const x=XR.xp[o],y=XR.xp[o+1],z=XR.xp[o+2],R=Math.max(.02,XR.xp[o+3]),
    dx=Math.max(0,Math.abs(x)-(pAsp||1)),dy=Math.max(0,Math.abs(y)-1),dz=Math.max(0,Math.abs(z)-1.5);
  return Math.max(0,1-Math.hypot(dx,dy,dz)/R);
}
function sndAct(){
  let a=0;
  if(XR.on){for(let i=0;i<6;i++){const o=i*4;if(XR.xp[o+3]>0){const v=Math.hypot(XR.xq[o],XR.xq[o+1],XR.xq[o+2]);a+=Math.min(1,v/.035)*Math.min(1,Math.abs(XR.xq[o+3])*1.5+.25)*sndTouch(o)}}}
  else if(typeof MS!=='undefined'&&MS.on)a=Math.min(1,Math.hypot(MS.vx,MS.vy)/6);
  return Math.min(1,a);
}
function sndPan(c,g){if(c.createStereoPanner){const p=c.createStereoPanner();p.pan.value=Math.random()*2-1;g.connect(p);p.connect(SND.m)}else g.connect(SND.m)}
function sndLoopStop(){if(SND.src){try{SND.src.stop()}catch(e){}try{SND.src.disconnect()}catch(e){}SND.src=null}}
function sndFrame(dt){
  const c=SND.ctx;if(!c||c.state!=='running')return;
  const on=$snd('snd').checked,vol=+$snd('sndv').value,a=on?sndAct():0,mode=+$snd('sndm').value,
    md=(mode>0&&!SND.bufs.length)?-1:mode,pt=+$snd('sndpt').value,gr=+$snd('sndgr').value,vr=+$snd('sndvr').value;
  SND.sm+=(a-SND.sm)*Math.min(1,dt*10);
  SND.m.gain.setTargetAtTime(md===-1?0:vol*(md===3?1:Math.min(1,SND.sm*1.4)),c.currentTime,.03);
  if(md!==2)sndLoopStop();
  if(md===-1)return;
  const rate=()=>Math.max(.05,pt*(1+(SND.sm-.4)*vr*1.5));
  if(md===2){   /* loop del primo file: intonazione e volume seguono il movimento */
