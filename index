<div id="hrmt"><span>Gesto</span><div class="aumt"><div></div></div><span>Apertura</span><div class="aumt"><div></div></div><span>Dita</span><div class="aumt"><div></div></div><span>Colpo</span><div class="aumt"><div></div></div></div>
