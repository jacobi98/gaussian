/* UNICA differenza tra dispositivi: su Quest e mobile si parte con 2000 particelle (countOf(.15)=2000). Tutti gli altri parametri sono identici su computer, Android, iPhone e Quest. */
const LOWP=/Quest|OculusBrowser|Pico|Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent)||(/Macintosh/.test(navigator.userAgent)&&navigator.maxTouchPoints>1)||!!(navigator.userAgentData&&navigator.userAgentData.mobile);
if(LOWP){byId('den').value=.15;
  /* TETTI SOLO SU QUEST/MOBILE (i valori di partenza restano uguali agli altri dispositivi): evitano surriscaldamento e lag */
  const cap=(id,mx)=>{const e=byId(id);if(e)e.max=mx};
  cap('den',.65);     /* particelle: max 20.000 (su computer 100.000) */
  cap('trk',8);       /* campioni scie: max 8 (su computer 16) */
  cap('trl',1);       /* lunghezza scie: max 1 (su computer 2) */
  cap('wchn',8000);   /* capelli webcam: max 8000 (su computer 16000) */
  cap('i3mvq',100);   /* particelle per fotogramma col pennello VR: max 100 (su computer 200) */
  cap('xrres',.9);    /* risoluzione VR: max 0.9 (su computer 1.2) */
  /* se i fotogrammi calano per ~3 s, scende da solo il numero di particelle (mai sotto 2000) */
  envScale=.55;   /* le stanze partono a risoluzione leggermente ridotta (poi si adatta da sola) */
  window.LOWAUTO=1;let lowN=0,lowT=0;
  window.lowThrottle=fps=>{
    if(performance.now()-lowT<4000)return;                 /* una correzione ogni 4 s al massimo */
    if(fps>0&&fps<30)lowN++;else lowN=0;
    if(lowN<6)return;lowN=0;
    const d=byId('den'),v=+d.value;if(v<=.15)return;
    d.value=Math.max(.15,v-.05);d.dispatchEvent(new Event('input',{bubbles:true}));lowT=performance.now();
  };
}
