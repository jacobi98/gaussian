    if(t==='f'){args.push(dv.getFloat32(i));i+=4}
    else if(t==='i'){args.push(dv.getInt32(i));i+=4}
    else if(t==='d'){args.push(dv.getFloat64(i));i+=8}
    else if(t==='h'){args.push(Number(dv.getBigInt64(i)));i+=8}
