async function handleOutputCommand(msg){
  const cmd=msg&&msg.cmd,data=msg&&msg.data;
  if(cmd==='panel:toggle')togglePanel();
  else if(cmd==='view')setView(String(data));
  else if(cmd==='format')await setFormat(String(data));
  else if(cmd==='mode')setMode(String(data));
  else if(cmd==='cap'){RENDER_CAP=Math.max(640,Math.min(4096,+data||1600));fit()}
  else if(cmd==='fps')OUTFPS=Math.max(0,Math.min(240,+data||0));
  else if(cmd==='autoq')OUTAUTO=data===true||data==='1'||data===1;
  else if(cmd==='pause')PAUSED=data===undefined?!PAUSED:!!data;
  else if(cmd==='blackout'){BLACKOUT=data===undefined?!BLACKOUT:!!data;document.body.classList.toggle('blackout',BLACKOUT)}
  else if(cmd==='media:open')await loadMediaUrls((data&&data.urls)||[],!(data&&data.replace===false));
  else if(cmd==='ply:open')await loadPlyUrl(typeof data==='string'?data:(data&&data.url),data&&data.name);
  else if(cmd==='params')applyParams(data);
  else if(cmd==='reset')reset();
  else if(cmd==='reload')location.reload();
  else if(cmd==='osc'&&data)onOSC({a:data.address,v:data.args||[]});
}
function initOutputMode(){
  if(!OUT)return;
  document.body.classList.add('outmode');
  if(window.fluidaBridge){
    window.fluidaBridge.onCommand(handleOutputCommand);
