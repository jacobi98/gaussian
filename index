async function loadMediaUrls(list,replace){
  const arr=(list||[]).filter(Boolean);if(!arr.length)return;
  const mode=$fitm.value,add=[];
  for(let k=0;k<arr.length;k++){
    const it=typeof arr[k]==='string'?{url:arr[k]}:arr[k];
    const url=it.url||it.path;if(!url)continue;
    const name=it.name||url.split(/[\\/]/).pop()||'media';
    seqStatus(`Carico ${k+1} / ${arr.length}…`);
    if(/\.ply$/i.test(name)){await loadPlyUrl(url,name);return}
    const isv=(it.type||'').startsWith('video/')||/\.(mp4|webm|mov|mkv|m4v)$/i.test(name);
    try{
      const src=isv?await loadVideo(url):await decodeFile(url),cv=toCv(src,mode),entry={f:null,url,cv,th:thumbOf(cv)};
      if(isv){entry.vid=src;entry.poster=cloneCv(cv);entry.lt=-1}
