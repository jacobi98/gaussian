    try{if(prjEl('i3mk').value==='cam'){prjSt('Riavvio la webcam…');if(CAMK.s)camStop();await camSync()}}catch(e){console.warn('webcam maschera',e)}   /* Sorgente particelle = Webcam: il caricamento imposta solo il menu, la camera va aperta */
    try{
