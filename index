/* pizzica con due dita sull'anteprima per zoomare */
{
  const PT=new Map();let d0=0,z0=1;
  const act=e=>e.pointerType==='touch'&&document.body.classList.contains('wcon')&&WC.on;
  stage.addEventListener('pointerdown',e=>{
    if(!e.target.closest('#pcsheet,#pcfmt'))pcq('pcsheet').hidden=true;
    if(!act(e))return;PT.set(e.pointerId,[e.clientX,e.clientY]);
    if(PT.size===2){const[a,b]=[...PT.values()];d0=Math.hypot(a[0]-b[0],a[1]-b[1]);z0=WC.z||1}
  });
  stage.addEventListener('pointermove',e=>{
    if(!PT.has(e.pointerId))return;PT.set(e.pointerId,[e.clientX,e.clientY]);
    if(PT.size===2&&d0>10){const[a,b]=[...PT.values()];pcSetZoom(z0*Math.hypot(a[0]-b[0],a[1]-b[1])/d0)}
  });
  const up=e=>{PT.delete(e.pointerId);if(PT.size<2)d0=0};
  stage.addEventListener('pointerup',up);stage.addEventListener('pointercancel',up);
}

