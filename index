/* ================= FOTOCAMERA STILE TELEFONO: selfie/posteriore, obiettivi, zoom, formato, rotazione ================= */
const pcq=id=>document.getElementById(id);
const pcFmtZ=z=>(Math.round(z*10)/10).toString().replace('.',',')+'×';
const pcFront=l=>/front|user|anterior|facetime/i.test(l||'');
let pcLt=0,pcHb=0,pcHn=null;

/* elenco obiettivi (chip 0,5× · 1× · 2× …): con zoom hardware sono valori di zoom, altrimenti sono le camere del telefono + 2× digitale */
async function pcLenses(){
  const my=++pcLt;let devs=[];
  try{devs=(await navigator.mediaDevices.enumerateDevices()).filter(d=>d.kind==='videoinput')}catch(e){}
  if(my!==pcLt||!WC.on)return;
  WC.devs=devs;
  const L=[],zc=WC.zc;
  if(zc){
    if(zc.min<.95)L.push({t:pcFmtZ(zc.min),z:zc.min});
    for(const z of[1,2,3,5])if(z>=Math.max(1,zc.min)&&z<=zc.max+.01)L.push({t:pcFmtZ(z),z});
  }else{
    const same=devs.filter(d=>WC.face==='user'?pcFront(d.label):!pcFront(d.label));
    if(same.length>1){
      let mu=false;
      same.forEach((d,i)=>{const l=d.label||'';let t,r;
        if(/ultra/i.test(l)){t='0,5×';r=0}else if(/tele/i.test(l)){t='Tele';r=3}else if(!mu){t='1×';r=1;mu=true}else{t='Ob.'+(i+1);r=2}
        L.push({t,d:d.deviceId,z:1,r})});
      L.sort((a,b)=>a.r-b.r);
      const mn=L.find(c=>c.r===1)||L[0];
      L.push({t:'2×',z:2,dig:true,d:mn.d});
    }else L.push({t:'1×',z:1},{t:'2×',z:2,dig:true});
  }
  PCS.L=L;pcRenderLenses();
}
function pcRenderLenses(){
  const e=pcq('pclens'),L=PCS.L||[];
  if(!WC.on||L.length<2){e.hidden=true;return}
  let act=-1;
  if(WC.zc)L.forEach((c,i)=>{if(c.z<=WC.z+.02)act=i});
  else{const di=L.findIndex(c=>c.dig);act=(di>=0&&WC.z>=1.5)?di:L.findIndex(c=>!c.dig&&(!c.d||c.d===WC.devId))}
  if(act<0)act=0;
  e.hidden=false;
  e.innerHTML=L.map((c,i)=>'<button class="pcl'+(i===act?' pa':'')+'" data-i="'+i+'">'+(i===act&&(WC.zc||c.dig)&&Math.abs(WC.z-c.z)>.04?pcFmtZ(WC.z):c.t)+'</button>').join('');
}
pcq('pclens').addEventListener('click',async e=>{
  const b=e.target.closest('button[data-i]'),c=b&&PCS.L[+b.dataset.i];if(!c)return;
  if(c.d&&c.d!==WC.devId)await wcStart(c.d);
  if(WC.on)pcSetZoom(c.z);
});

/* zoom: hardware se il telefono lo espone (anche sotto 1×), altrimenti digitale */
async function pcHW(z){
  pcHn=z;if(pcHb)return;pcHb=1;
  while(pcHn!=null){
    const v=pcHn;pcHn=null;
    try{const tr=WC.st&&WC.st.getVideoTracks()[0];if(tr)await tr.applyConstraints({advanced:[{zoom:v}]})}
    catch(e){WC.zc=null;WC.dz=Math.max(1,v);WC.z=WC.dz;pcLenses();pcSync()}   /* zoom hardware non applicabile: passa al digitale */
  }
  pcHb=0;
}
function pcSetZoom(z){
  if(!WC.on)return;
  const zc=WC.zc;
  if(zc){z=Math.min(zc.max,Math.max(zc.min,z));WC.z=z;WC.dz=1;pcHW(z)}
  else{z=Math.min(8,Math.max(1,z));WC.z=z;WC.dz=z}
  pcSync();
}
function pcSync(){
  const on=!!WC.on,z=pcq('pcz'),zc=WC.zc;
  pcq('pcstart').hidden=on;
  z.min=zc?zc.min:1;z.max=zc?Math.min(zc.max,20):8;z.step=.05;z.value=WC.z||1;z.disabled=!on;
  z.style.setProperty('--p',(100*(z.value-z.min)/(z.max-z.min))+'%');
  const bz=z.parentNode.querySelector('b');if(bz)bz.textContent=+(+z.value).toFixed(2);
  pcq('pcface').value=WC.face||'user';
  pcFmtUI();pcRenderLenses();
}
pcq('pcz').addEventListener('input',e=>pcSetZoom(+e.target.value));
pcq('pcface').addEventListener('change',e=>{WC.face=e.target.value;if(WC.on)wcStart(null,e.target.value);else pcSync()});
const pcFlip=()=>wcStart(null,WC.on?(WC.face==='environment'?'user':'environment'):WC.face);
