  addEventListener('keydown',e=>{
    if(e.key==='F3'){e.preventDefault();togglePanel()}
    else if(e.key==='Escape'&&document.body.classList.contains('panelopen'))togglePanel(false);
  });
  setInterval(outputStatus,1000);outputStatus();
  (async()=>{
    const ar=OQ.get('ar');if(ar&&ARS[ar])await setFormat(ar);
    const view=OQ.get('view');if(view&&view!==V){setView(view);if(view==='wc'&&!WC.on)wcStart()}
    fit();
  })();
}

