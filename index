let PLYSRC=null;
{const _lp=loadPLY;loadPLY=async function(f){const b=OBJ;await _lp(f);if(f&&OBJ!==b)PLYSRC=f}}
const PRJ_SEQ=['xf','hold','auto','fitm','vspd','wcam'];
const prjEl=id=>document.getElementById(id);
const prjSt=m=>{const e=prjEl('prjs');if(e)e.textContent=m||''};
const prjMb=n=>(n/1048576).toFixed(n>1048576*10?0:1)+' MB';
const prjB64=f=>new Promise((ok,ko)=>{const r=new FileReader();r.onload=()=>{const t=r.result;ok(t.slice(t.indexOf(',')+1))};r.onerror=()=>ko(r.error);r.readAsDataURL(f)});
function prjBlob(b64,type){const parts=[],CH=4*1024*1024;for(let i=0;i<b64.length;i+=CH){const t=atob(b64.slice(i,i+CH)),u=new Uint8Array(t.length);for(let k=0;k<t.length;k++)u[k]=t.charCodeAt(k);parts.push(u)}return new Blob(parts,{type:type||''})}
function prjCollect(){
