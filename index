    prjSt('Progetto aperto: '+file.name+(skipped?' · '+skipped+' media non erano incorporati nel file (mantenuti quelli attuali)':'')+(P.ply&&P.ply.skipped?' · l\'oggetto PLY non era incorporato':''));
  }catch(e){console.error(e);prjSt('Errore nell\'apertura: '+(e&&e.message||e))}
  finally{prjBusy=false}
