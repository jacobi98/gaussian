/* ---- fluido Navier-Stokes (stable fluids, CPU) guidato dal movimento della silhouette ---- */
function fProj(u,v,p,dv,gw,gh,it){
  for(let y=1;y<gh-1;y++)for(let x=1;x<gw-1;x++){const i=y*gw+x;dv[i]=-.5*(u[i+1]-u[i-1]+v[i+gw]-v[i-gw]);p[i]=0}
  for(let k=0;k<it;k++)for(let y=1;y<gh-1;y++)for(let x=1;x<gw-1;x++){const i=y*gw+x;p[i]=(dv[i]+p[i-1]+p[i+1]+p[i-gw]+p[i+gw])*.25}
  for(let y=1;y<gh-1;y++)for(let x=1;x<gw-1;x++){const i=y*gw+x;u[i]-=.5*(p[i+1]-p[i-1]);v[i]-=.5*(p[i+gw]-p[i-gw])}
}
function fAdv(dst,src,u,v,d,gw,gh){
  for(let y=0;y<gh;y++)for(let x=0;x<gw;x++){
    const i=y*gw+x;let px=x-u[i]*d,py=y-v[i]*d;
    px=px<.5?.5:px>gw-1.5?gw-1.5:px;py=py<.5?.5:py>gh-1.5?gh-1.5:py;
    const x0=px|0,y0=py|0,fx=px-x0,fy=py-y0,k=y0*gw+x0;
    dst[i]=(src[k]*(1-fx)+src[k+1]*fx)*(1-fy)+(src[k+gw]*(1-fx)+src[k+gw+1]*fx)*fy;
  }
}



