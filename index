let prjBusy=false;
async function prjSave(){
  if(prjBusy)return;prjBusy=true;
  try{
    const stamp=new Date().toISOString().slice(0,16).replace(/[:T]/g,'-'),name='fluida-progetto-'+stamp+'.json';
    let h=null;   /* il selettore file va chiesto subito, mentre il click è ancora "fresco" */
    if(window.showSaveFilePicker){
      try{h=await showSaveFilePicker({suggestedName:name,types:[{description:'Progetto Fluida',accept:{'application/json':['.json']}}]})}
      catch(e){if(e&&e.name==='AbortError'){prjSt('Salvataggio annullato.');return}h=null}
    }
    prjSt('Preparo il progetto…');
    const meta=prjCollect(),items=IMGS.filter(m=>!m.live);
    let inc=!!document.querySelector('[data-prj=media]').checked,note='';
    if(inc){let tot=PLYSRC?PLYSRC.size:0;items.forEach(m=>{if(m.f)tot+=m.f.size});
      if(tot>300*1048576){inc=false;note=' · media troppo pesanti ('+prjMb(tot)+'): salvate solo le impostazioni'}}
    const parts=['{"meta":',JSON.stringify(meta),',"media":['];
    let first=true,n=0,skipped=0;
    for(const m of items){
      if(!first)parts.push(',');first=false;
      if(inc&&m.f){prjSt(`Incorporo i media… ${++n} / ${items.length}`);parts.push('{"name":',JSON.stringify(m.f.name||'media'),',"type":',JSON.stringify(m.f.type||''),',"b64":"',await prjB64(m.f),'"}')}
      else if(m.url)parts.push(JSON.stringify({url:m.url,name:m.name||'',type:''}));
      else{skipped++;parts.push(JSON.stringify({name:m.f?m.f.name:'',skipped:true}))}
    }
    parts.push('],"ply":');
    if(inc&&PLYSRC)parts.push('{"name":',JSON.stringify(PLYSRC.name),',"b64":"',await prjB64(PLYSRC),'"}');
    else parts.push(PLYSRC?JSON.stringify({name:PLYSRC.name,skipped:true}):'null');
    let mask=null;try{if(MKO.cv)mask=MKO.cv.toDataURL('image/png')}catch(e){}
    parts.push(',"mask":',JSON.stringify(mask),'}');
    const blob=new Blob(parts,{type:'application/json'});
    let out=name;
    if(h){try{const w=await h.createWritable();await w.write(blob);await w.close();out=h.name}catch(e){h=null}}
    if(!h){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),5000)}
    prjSt('Progetto salvato: '+out+' ('+prjMb(blob.size)+')'+note);
  }catch(e){console.error(e);prjSt('Errore nel salvataggio: '+(e&&e.message||e))}
  finally{prjBusy=false}
}
async function prjOpen(file){
